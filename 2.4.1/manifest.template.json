{
  "schemaVersion": 1,
  "id": "npc-gallery",
  "name": "NPC Gallery",
  "version": "1.2.0",
  "description": "Persistent, editable NPC memory for Marinara Engine.",
  "engine": {
    "min": "2.4.1",
    "maxExclusive": "2.5.0"
  },
  "kind": ["agent"],
  "entrypoints": {
    "server": "server.mjs",
    "client": "client.js",
    "agents": "agents.json"
  },
  "contributions": {
    "slots": ["chat-settings", "chat-runtime"],
    "agentDetail": {
      "agentIds": ["npc-gallery"]
    }
  },
  "files": [],
  "permissions": ["agent-runtime", "routes", "storage", "ui"],
  "restartRequired": true
}
