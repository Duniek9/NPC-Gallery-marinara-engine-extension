{
  "schemaVersion": 1,
  "id": "npc-gallery",
  "name": "NPC Gallery",
  "version": "1.3.1",
  "description": "Persistent, editable NPC memory for Marinara Engine.",
  "engine": {
    "min": "2.4.6",
    "maxExclusive": "2.4.7"
  },
  "kind": ["agent"],
  "entrypoints": {
    "server": "server.mjs",
    "client": "client.js",
    "agents": "agents.json"
  },
  "contributions": {
    "slots": ["chat-settings", "conversation-surface"],
    "agentDetail": {
      "agentIds": ["npc-gallery"]
    }
  },
  "files": [],
  "permissions": ["agent-runtime", "prompt-context", "routes", "storage", "ui"],
  "restartRequired": true
}
